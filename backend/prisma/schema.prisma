generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String?  @unique
  passwordHash  String
  firstName     String
  lastName      String
  photo         String?
  sidebarPrefs  Json?
  role          String   @default("SUPER_ADMIN")
  isActive      Boolean  @default(true)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  auditLogs     AuditLog[]
  notifications Notification[]
  managedChantiers Chantier[]
  internalStaff InternalStaff?
  cashAccounts  CashAccount[]
}

model InternalStaff {
  id               String   @id @default(cuid())
  reference        String?  @unique
  firstName        String
  lastName         String
  photo            String?
  email            String?
  cin              String?
  birthDate        DateTime?
  address          String?
  phone1           String?
  phone2           String?
  jobTitle         String?
  department       String?
  hireDate         DateTime?
  contractType     String?
  monthlySalary    Float    @default(0)
  salaryPeriod     String   @default("mensuel")
  declared         Boolean  @default(false)
  cnssNumber       String?
  bankAccount      String?
  bankName         String?
  rib              String?
  emergencyContact String?
  remark           String?
  isActive         Boolean  @default(true)
  userId           String?  @unique
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  documents        InternalStaffDocument[]
  salaryRecords    InternalStaffSalaryRecord[]
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entity     String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model InternalStaffDocument {
  id        String        @id @default(cuid())
  staffId   String
  staff     InternalStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  docType   String
  reference String?
  data      String?
  createdAt DateTime      @default(now())
}

model InternalStaffSalaryRecord {
  id           String        @id @default(cuid())
  staffId      String
  staff        InternalStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  periodYear   Int
  periodMonth  Int
  periodWeek   Int           @default(0)
  salaryPeriod String        @default("mensuel")
  baseSalary   Float         @default(0)
  bonus        Float         @default(0)
  deduction    Float         @default(0)
  advance      Float         @default(0)
  netSalary    Float         @default(0)
  status       String        @default("brouillon")
  paidAt       DateTime?
  remark       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([staffId, periodYear, periodMonth, periodWeek])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model DropdownOption {
  id        String   @id @default(cuid())
  category  String
  label     String
  value     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([category, value])
}

model Agent {
  id          String   @id @default(cuid())
  reference   String?  @unique
  photo       String?
  remark      String?
  firstName   String
  lastName    String
  email       String?
  phone1      String?
  phone2      String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clients     Client[]
}

model Reconnu {
  id         String   @id @default(cuid())
  reference  String?  @unique
  firstName  String
  lastName   String
  phone1     String?
  phone2     String?
  address    String?
  relation   String?  // ex: femme de ménage, fournisseur ponctuel
  remark     String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  movements  OfficeCashMovement[]
}

model OfficeCashMovement {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  /// entree | sortie
  direction    String
  amount       Float
  /// chantier | travail | aleatoire | alimentation (for entree)
  purpose      String
  designation  String
  workLabel    String?
  chantierId   String?
  chantier     Chantier? @relation(fields: [chantierId], references: [id])
  reconnuId    String?
  reconnu      Reconnu?  @relation(fields: [reconnuId], references: [id])
  /// Nom libre si la personne n'est pas dans la liste des reconnus
  reconnuName  String?
  proofFile    String?
  remark       String?
  createdBy    String?
  createdAt    DateTime @default(now())
}

model Mandant {
  id            String   @id @default(cuid())
  reference     String?  @unique
  photo         String?
  remark        String?
  firstName     String
  lastName      String
  identityType  String?
  identityNumber String? @unique
  birthDate     DateTime?
  email         String?
  phone1        String?
  phone2        String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  clients       ClientMandant[]
}

model Client {
  id              String   @id @default(cuid())
  reference       String   @unique
  photo           String?
  firstName       String
  lastName        String
  identityType    String?
  identityNumber  String?  @unique
  birthDate       DateTime?
  email           String
  phone1          String
  phone2          String?
  address         String?
  isProspect      Boolean  @default(true)
  isBuyer         Boolean  @default(false)
  isTenant        Boolean  @default(false)
  agentId         String?
  agent           Agent?   @relation(fields: [agentId], references: [id])
  source          String?
  remark          String?
  nb              String?
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mandants        ClientMandant[]
  sales           Sale[]
  rentals         Rental[]
  documents       Document[]
  agentHistory    ClientAgentHistory[]
  projects        Project[]
}

model ClientAgentHistory {
  id                String   @id @default(cuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  previousAgentId   String?
  previousAgentName String?
  newAgentId        String?
  newAgentName      String?
  changedBy         String?
  createdAt         DateTime @default(now())
}

model ClientMandant {
  id        String  @id @default(cuid())
  clientId  String
  mandantId String
  client    Client  @relation(fields: [clientId], references: [id])
  mandant   Mandant @relation(fields: [mandantId], references: [id])

  @@unique([clientId, mandantId])
}

model Location {
  id          String   @id @default(cuid())
  name        String
  city        String?
  description String?
  createdAt   DateTime @default(now())
  projects    Project[]
}

model Project {
  id            String         @id @default(cuid())
  reference     String?        @unique
  name          String
  ownershipType String         @default("personnel") // personnel | client
  clientId      String?
  client        Client?        @relation(fields: [clientId], references: [id])
  city          String?
  address       String?
  description   String?
  remark        String?
  photo         String?
  status        String         @default("actif")
  locationId    String?
  location      Location?      @relation(fields: [locationId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tranches      Tranche[]
  properties    Property[]
  chantiers     Chantier[]
  purchases     Purchase[]
  enginAssignments EnginAssignment[]
  images        ProjectImage[]
  /// JSON : { custom:[{key,label,required}], labels:{ [standardKey]: string } }
  docChecklist  String?
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Tranche {
  id        String   @id @default(cuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  blocs     Bloc[]
}

model Bloc {
  id        String   @id @default(cuid())
  name      String
  trancheId String
  tranche   Tranche  @relation(fields: [trancheId], references: [id])
  lots      Lot[]
}

model Lot {
  id     String  @id @default(cuid())
  name   String
  blocId String
  bloc   Bloc    @relation(fields: [blocId], references: [id])
  floors Floor[]
}

model Floor {
  id         String     @id @default(cuid())
  name       String
  lotId      String
  lot        Lot        @relation(fields: [lotId], references: [id])
  properties Property[]
}

model Property {
  id               String   @id @default(cuid())
  reference        String   @unique
  titleNumber      String?
  name             String
  city             String?
  description      String?
  surface          Float?
  rooms            Int?
  status           String   @default("disponible")
  contractualDesc  String?
  photo            String?
  price            Float?
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id])
  floorId          String?
  floor            Floor?   @relation(fields: [floorId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sales            Sale[]
  rentals          Rental[]
  documents        Document[]
}

model Sale {
  id                String   @id @default(cuid())
  reference         String   @unique
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id])
  propertyId        String
  property          Property @relation(fields: [propertyId], references: [id])
  contractDate      DateTime?
  sellerSignatureDate String?
  sellerLegalizationNo String?
  buyerSignatureDate  String?
  buyerLegalizationNo String?
  salePrice         Float
  discount          Float    @default(0)
  advance           Float    @default(0)
  netPrice          Float
  totalPaid         Float    @default(0)
  remaining         Float
  contractType      String?
  description       String?
  status            String   @default("brouillon")
  resiliationMotif  String?
  resiliatedAt      DateTime?
  resiliatedBy      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  payments          Payment[]
  documents         Document[]
  schedules         PaymentSchedule[]
}

model Rental {
  id                String   @id @default(cuid())
  reference         String   @unique
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id])
  propertyId        String
  property          Property @relation(fields: [propertyId], references: [id])
  contractDate      DateTime?
  /// Début de location (1er mois de loyer)
  startDate         DateTime?
  /// Fin de location (optionnel = bail ouvert)
  endDate           DateTime?
  landlordSignatureDate String?
  landlordLegalizationNo String?
  tenantSignatureDate String?
  tenantLegalizationNo String?
  monthlyRent       Float
  discount          Float    @default(0)
  totalPaid         Float    @default(0)
  remaining         Float    @default(0)
  contractType      String?
  description       String?
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  payments          Payment[]
  documents         Document[]
  schedules         PaymentSchedule[]
}

model PaymentSchedule {
  id        String    @id @default(cuid())
  saleId    String?
  sale      Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  rentalId  String?
  rental    Rental?   @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  amount    Float
  label     String?
  status    String    @default("pending")
  paidAt    DateTime?
  remark    String?
  createdAt DateTime  @default(now())
  payments  Payment[]
}

model Payment {
  id            String   @id @default(cuid())
  receiptNo     String   @unique
  saleId        String?
  sale          Sale?    @relation(fields: [saleId], references: [id])
  rentalId      String?
  rental        Rental?  @relation(fields: [rentalId], references: [id])
  scheduleId    String?
  schedule      PaymentSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  date          DateTime @default(now())
  amount        Float
  nature        String?
  internalRef   String?  @unique
  operationType String?
  proofFile     String?
  operationNo   String?  @unique
  bank          String?
  payerName     String?
  createdAt     DateTime @default(now())
}

model CashAccount {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("caisse")
  isActive     Boolean  @default(true)
  holderUserId String?
  holderUser   User?    @relation(fields: [holderUserId], references: [id])
  rib          String?
  bankName     String?
  createdAt    DateTime @default(now())
  movements    CashMovement[]
}

model CashMovement {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  designation      String
  accountId        String
  account          CashAccount @relation(fields: [accountId], references: [id])
  mode             String?
  debit            Float    @default(0)
  credit           Float    @default(0)
  remark           String?
  proofFile        String?
  invoiceFile      String?
  deliveryNoteFile String?
  receptionPvFile  String?
  /// encaissement | achat | main_oeuvre | equipe_interne
  sourceType       String?
  sourceId         String?
  isAutomatic      Boolean  @default(false)
  createdBy        String?
  createdAt        DateTime @default(now())
}

model WorkforcePayrollRecord {
  id          String    @id @default(cuid())
  reference   String?   @unique
  workforceId String
  workforce   Workforce @relation(fields: [workforceId], references: [id], onDelete: Cascade)
  periodYear  Int
  periodMonth Int
  brut        Float     @default(0)
  advances    Float     @default(0)
  bonuses     Float     @default(0)
  netDue      Float     @default(0)
  amountPaid  Float     @default(0)
  remaining   Float     @default(0)
  paymentMode String?
  status      String    @default("pending")
  paidAt      DateTime?
  remark      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workforceId, periodYear, periodMonth])
}

model Supplier {
  id            String   @id @default(cuid())
  reference     String   @unique
  companyName   String
  contactName   String?
  phone1        String?
  phone2        String?
  email         String?
  address       String?
  cin           String?  @unique
  source        String?
  bankName      String?
  rib           String?
  passwordHash  String?
  portalRole    String?  @default("ACHATS")
  remark        String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  purchases     Purchase[]
  documents     Document[]
  supplierDocs  SupplierDocument[]
  rentedEngins  Engin[]
}

model PurchaseFamily {
  id          String   @id @default(cuid())
  name        String   @unique
  designations PurchaseDesignation[]
}

model PurchaseDesignation {
  id       String         @id @default(cuid())
  label    String
  familyId String
  family   PurchaseFamily @relation(fields: [familyId], references: [id])
  purchases Purchase[]
}

model Purchase {
  id            String   @id @default(cuid())
  reference     String   @unique
  date          DateTime @default(now())
  family        String?
  designation   String
  designationId String?
  designationRef PurchaseDesignation? @relation(fields: [designationId], references: [id])
  unit          String?
  quantity      Float
  unitPrice     Float
  amountHT      Float?
  tvaRate       Float    @default(20)
  tvaAmount     Float?
  totalPrice    Float
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  author        String?
  paymentMode   String?
  invoiced      Boolean  @default(false)
  chantierId    String?
  chantier      Chantier? @relation(fields: [chantierId], references: [id])
  tranche       String?
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  /// elabore | soumis | livre | valide | facture | paye | archive
  status        String   @default("elabore")
  /// marchandise | outil
  purchaseType  String   @default("marchandise")
  requester     String?
  responsible   String?
  expectedDeliveryDate DateTime?
  advanceAmount Float    @default(0)
  advanceMode   String?
  paidAmount    Float    @default(0)
  /// non_paye | partiel | paye
  paymentStatus String   @default("non_paye")
  /// non_livre | partiel | livre
  deliveryStatus String  @default("non_livre")
  remark        String?
  proofFile     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  history       PurchaseHistory[]
  lines         PurchaseLine[]
  deliveries    PurchaseDelivery[]
  payments      PurchasePayment[]
}

model PurchaseLine {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    String
  reference  String?
  family     String?
  quantity   Float
  unit       String?
  unitPrice  Float
  tvaRate    Float    @default(20)
  amountHT   Float    @default(0)
  tvaAmount  Float    @default(0)
  amountTTC  Float    @default(0)
  sortOrder  Int      @default(0)
  deliveryItems PurchaseDeliveryItem[]
}

model PurchaseDelivery {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  number     String?
  remark     String?
  createdBy  String?
  createdAt  DateTime @default(now())
  items      PurchaseDeliveryItem[]
}

model PurchaseDeliveryItem {
  id               String   @id @default(cuid())
  deliveryId       String
  delivery         PurchaseDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  lineId           String
  line             PurchaseLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  quantity         Float    @default(0)
  rejectedQuantity Float    @default(0)
  remark           String?
}

model PurchasePayment {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  /// avance | complement | solde
  kind       String   @default("complement")
  date       DateTime @default(now())
  amount     Float
  mode       String?
  reference  String?
  remark     String?
  createdBy  String?
  createdAt  DateTime @default(now())
}

model PurchaseHistory {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  userName   String?
  oldStatus  String?
  newStatus  String
  comment    String?
  createdAt  DateTime @default(now())
}

model Chantier {
  id           String   @id @default(cuid())
  name         String
  address      String?
  startDate    DateTime?
  workerCount  Int      @default(0)
  managerName  String?
  remark       String?
  status       String   @default("actif")
  progressPct  Float    @default(0)
  budgetAchats Float?
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  endDate      DateTime?
  photo        String?
  managerUserId String?
  managerUser  User?    @relation(fields: [managerUserId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  purchases    Purchase[]
  assignments  WorkforceAssignment[]
  pointages    Pointage[]
  pointageSessions PointageSession[]
  progress     WorkProgress[]
  missions     Mission[]
  enginAssignments EnginAssignment[]
  enginUsages  EnginUsage[]
  enginExpenses EnginExpense[]
  enginMaintenances Maintenance[]
  enginFuelLogs FuelLog[]
  documents    Document[]
  cameras      ChantierCamera[]
  tranches     ChantierTranche[]
  stockItems   ChantierStockItem[]
  subcontractors ChantierSubcontractor[]
  images         ChantierImage[]
  officeCashMovements OfficeCashMovement[]
}

model ChantierImage {
  id         String   @id @default(cuid())
  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  path       String
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model ChantierTranche {
  id                 String    @id @default(cuid())
  name               String
  chantierId         String
  chantier           Chantier  @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  remark             String?
  estimatedStartDate DateTime?
  estimatedEndDate   DateTime?
  createdAt          DateTime  @default(now())

  @@unique([chantierId, name])
}

model ChantierStockItem {
  id         String   @id @default(cuid())
  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  name       String
  quantity   Float    @default(0)
  unit       String?
  tranche    String?
  remark     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ChantierSubcontractor {
  id          String   @id @default(cuid())
  chantierId  String
  chantier    Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  companyName String
  corpsEtat   String?
  phone       String?
  amount      Float?
  /// Pourcentage d'avancement déclaré (0–100)
  progressPct Float    @default(0)
  /// Montant déjà payé au sous-traitant
  paidAmount  Float    @default(0)
  status      String   @default("actif")
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChantierCamera {
  id         String   @id @default(cuid())
  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  name       String
  url        String
  zone       String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Workforce {
  id            String   @id @default(cuid())
  reference     String?  @unique
  photo         String?
  firstName     String
  lastName      String
  cin           String?  @unique
  birthDate     DateTime?
  address       String?
  phone1        String?
  phone2        String?
  email         String?
  category      String?
  groupe        String?
  workPassport  String?
  hireDate      DateTime?
  contractType  String?
  declared      Boolean  @default(false)
  cnssNumber    String?
  /** jour = pointage ; mois = salaire mensuel (hors pointage) */
  salaryPeriod  String   @default("jour")
  dailySalary   Float    @default(0)
  monthlySalary Float    @default(0)
  bankName      String?
  rib           String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  assignments   WorkforceAssignment[]
  pointages     Pointage[]
  generatedDocs WorkforceDocument[]
  payrollRecords WorkforcePayrollRecord[]
  vehicleAssignments DriverAssignment[]
  enginUsages   EnginUsage[]
}

/// Affectation chauffeur ↔ véhicule / engin (historisée)
model DriverAssignment {
  id          String    @id @default(cuid())
  workforceId String
  workforce   Workforce @relation(fields: [workforceId], references: [id], onDelete: Cascade)
  enginId     String
  engin       Engin     @relation(fields: [enginId], references: [id], onDelete: Cascade)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  remark      String?
  createdAt   DateTime  @default(now())
}

model WorkforceDocument {
  id          String    @id @default(cuid())
  workforceId String
  workforce   Workforce @relation(fields: [workforceId], references: [id])
  docType     String
  reference   String?
  data        String?
  createdAt   DateTime  @default(now())
}

model WorkforceAssignment {
  id           String    @id @default(cuid())
  workforceId  String
  workforce    Workforce @relation(fields: [workforceId], references: [id])
  chantierId   String
  chantier     Chantier  @relation(fields: [chantierId], references: [id])
  functionRole String?
  tranche      String?
  startDate    DateTime  @default(now())
  endDate      DateTime?
  suspendedFrom DateTime?
  suspendedUntil DateTime?
}

/// Un pointage (opération) = une journée pour un chantier ou une tranche.
model PointageSession {
  id          String     @id @default(cuid())
  chantierId  String
  chantier    Chantier   @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  /// "" = chantier entier, sinon nom de la tranche
  tranche     String     @default("")
  date        DateTime
  remark      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lines       Pointage[]

  @@unique([chantierId, tranche, date])
}

model Pointage {
  id            String    @id @default(cuid())
  date          DateTime
  workforceId   String
  workforce     Workforce @relation(fields: [workforceId], references: [id])
  chantierId    String?
  chantier      Chantier? @relation(fields: [chantierId], references: [id])
  sessionId     String?
  session       PointageSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  tranche       String?
  dayValue      Float     @default(0)
  hours         Float     @default(0)
  totalDay      Float     @default(0)
  dayRate       Float?
  advance       Float     @default(0)
  bonus         Float     @default(0)
  validated     Boolean   @default(false)
  validatedAt   DateTime?
  createdAt     DateTime  @default(now())

  /// Un pointage par ouvrier / jour / chantier (matrice multi-projets)
  @@unique([date, workforceId, chantierId])
}

model WorkProgress {
  id         String   @id @default(cuid())
  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id])
  tranche    String?
  groupe     String?
  etage      String?
  taskName   String
  percent    Float    @default(0)
  remark     String?
  /// Phases manuelles du lot : [{ percent, label, description?, deliverables? }]
  phases     Json?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model Engin {
  id            String   @id @default(cuid())
  code          String?  @unique
  /// engin | materiel
  kind          String   @default("engin")
  designation   String?
  model         String?
  acquisitionYear   Int?
  commissioningDate DateTime?
  location      String?
  photo         String?
  ownershipType String   @default("personnel") // personnel | loue
  acquisitionDate    DateTime?
  residualValue      Float?
  depreciationYears  Float?
  /// lineaire | degressif
  depreciationMethod String?  @default("lineaire")
  /// Coût d'utilisation standard (MAD / heure), hors amortissement
  usageCostPerHour   Float?
  rentalSupplier String?
  rentalSupplierId String?
  rentalSupplierRef Supplier? @relation(fields: [rentalSupplierId], references: [id])
  rentalMonthly  Float?
  rentalContractRef String?
  rentalStart    DateTime?
  rentalEnd      DateTime?
  rentalPrice    Float?
  /// jour | semaine | mois | projet | tranche
  rentalUnit     String?
  rentalDeposit  Float?
  rentalTransport Float?
  rentalExtraFees Float?
  rentalInsurance Float?
  rentalTvaRate  Float?
  rentalPaymentTerms String?
  brand         String?
  genre         String?
  groupe        String?
  workPassport  String?
  matricule     String?  @unique
  chassisNo     String?
  emptyWeight   Float?
  totalWeight   Float?
  gsmNumber     String?
  gpsNumber     String?
  gpsMountDate  DateTime?
  transferDate  DateTime?
  counterValue  Float?
  counterUnit   String?  @default("KM")
  counterDate   DateTime?
  purchasePrice Float?
  status        String   @default("disponible")
  fuelLevel     Float?
  insuranceExpiry DateTime?
  vignetteExpiry  DateTime?
  visitExpiry     DateTime?
  authExpiry      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  maintenances  Maintenance[]
  missions      Mission[]
  documents     Document[]
  fuelLogs      FuelLog[]
  gpsPositions  GpsPosition[]
  driverAssignments DriverAssignment[]
  assignments   EnginAssignment[]
  usages        EnginUsage[]
  expenses      EnginExpense[]
}

/// Affectation d'un engin / matériel à un projet, chantier ou tranche (historisée)
model EnginAssignment {
  id            String    @id @default(cuid())
  enginId       String
  engin         Engin     @relation(fields: [enginId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id])
  chantierId    String?
  chantier      Chantier? @relation(fields: [chantierId], references: [id])
  tranche       String?
  responsible   String?
  startDate     DateTime
  endDate       DateTime?
  /// propriete | location
  mode          String    @default("propriete")
  /// journalier | horaire | forfait
  costMethod    String    @default("journalier")
  dailyCost     Float     @default(0)
  hourlyCost    Float?
  flatAmount    Float?
  /// Frais ponctuels (transport, montage…) imputés une fois
  extraCost     Float     @default(0)
  plannedCost   Float     @default(0)
  remark        String?
  suspendedFrom DateTime?
  suspendedUntil DateTime?
  returnedAt    DateTime?
  returnCondition String?
  returnCounter Float?
  returnRemark  String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  usages        EnginUsage[]

  @@index([enginId, startDate])
  @@index([chantierId])
}

/// Pointage d'utilisation (heures / kilométrage)
model EnginUsage {
  id            String    @id @default(cuid())
  enginId       String
  engin         Engin     @relation(fields: [enginId], references: [id], onDelete: Cascade)
  assignmentId  String?
  assignment    EnginAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  date          DateTime
  chantierId    String?
  chantier      Chantier? @relation(fields: [chantierId], references: [id])
  tranche       String?
  driverId      String?
  driver        Workforce? @relation(fields: [driverId], references: [id])
  driverName    String?
  startTime     String?
  endTime       String?
  hours         Float     @default(0)
  kmStart       Float?
  kmEnd         Float?
  counterStart  Float?
  counterEnd    Float?
  remark        String?
  createdBy     String?
  createdAt     DateTime  @default(now())

  @@index([enginId, date])
}

/// Dépenses liées à l'engin / matériel (hors entretien, réparation, carburant)
model EnginExpense {
  id            String    @id @default(cuid())
  enginId       String
  engin         Engin     @relation(fields: [enginId], references: [id], onDelete: Cascade)
  date          DateTime
  category      String
  designation   String
  amount        Float
  supplier      String?
  /// direct = imputée au chantier/tranche ; reparti = répartie selon les affectations
  allocation    String    @default("reparti")
  chantierId    String?
  chantier      Chantier? @relation(fields: [chantierId], references: [id])
  tranche       String?
  invoiceRef    String?
  paymentMode   String?
  remark        String?
  createdBy     String?
  createdAt     DateTime  @default(now())

  @@index([enginId, date])
}

model Maintenance {
  id            String   @id @default(cuid())
  enginId       String
  engin         Engin    @relation(fields: [enginId], references: [id])
  date          DateTime @default(now())
  /// entretien | reparation
  kind          String   @default("entretien")
  maintenanceType String?
  breakdownNature String?
  description   String?
  repairer      String?
  partsCost     Float?
  laborCost     Float?
  downtimeDays  Float?
  allocation    String   @default("reparti")
  chantierId    String?
  chantier      Chantier? @relation(fields: [chantierId], references: [id])
  tranche       String?
  invoiceRef    String?
  responsible   String?
  supervisor    String?
  designation   String
  budget        Float?
  counterValue  Float?
  remark        String?
  createdAt     DateTime @default(now())
}

model Mission {
  id            String   @id @default(cuid())
  enginId       String
  engin         Engin    @relation(fields: [enginId], references: [id])
  date          DateTime @default(now())
  driverName    String?
  mission       String
  usage         String?
  chantierId    String?
  chantier      Chantier? @relation(fields: [chantierId], references: [id])
  tranche       String?
  requestedBy   String?
  remark        String?
  createdAt     DateTime @default(now())
}

/// Checklist de documents standards par fiche (client, chantier, ouvrier…).
model DocumentChecklist {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  /// { custom, labels, hidden }
  config     String   @default("{}")
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId])
}

model Document {
  id          String   @id @default(cuid())
  name        String
  category    String?
  /// pending | valid | invalid
  status      String   @default("pending")
  mimeType    String?
  size        Int?
  path        String
  entityType  String?
  entityId    String?
  expiresAt   DateTime?
  /// Frais du dossier (optionnel) — diminue le budget chantier si lié
  feeAmount   Float?
  estimatedStartDate DateTime?
  estimatedEndDate   DateTime?
  /// Dernière notif de retard (anti-spam)
  lateNotifiedAt DateTime?
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])
  saleId      String?
  sale        Sale?    @relation(fields: [saleId], references: [id])
  rentalId    String?
  rental      Rental?  @relation(fields: [rentalId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  chantierId  String?
  chantier    Chantier? @relation(fields: [chantierId], references: [id])
  enginId     String?
  engin       Engin?   @relation(fields: [enginId], references: [id])
  docNumber   String?
  docDate     DateTime?
  amount      Float?
  uploadedById   String?
  uploadedByName String?
  createdAt   DateTime @default(now())
}

model ArchiveEntry {
  id          String   @id @default(cuid())
  registerNo  String?
  date        DateTime @default(now())
  subject     String
  sender      String?
  recipient   String?
  category    String?
  direction   String?  @default("entrant")
  filePath    String?
  remark      String?
  emailTo     String?
  emailSentAt DateTime?
  entityType  String?
  entityId    String?
  createdAt   DateTime @default(now())
}

model Counter {
  id      String @id
  year    Int
  prefix  String
  value   Int    @default(0)

  @@unique([prefix, year])
}

model ConversationMessage {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  channel    String
  direction  String   @default("outbound")
  subject    String?
  body       String
  recipient  String?
  status     String   @default("sent")
  userId     String?
  userName   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model FuelLog {
  id           String   @id @default(cuid())
  enginId      String
  engin        Engin    @relation(fields: [enginId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  liters       Float
  cost         Float?
  counterValue Float?
  station      String?
  allocation   String   @default("reparti")
  chantierId   String?
  chantier     Chantier? @relation(fields: [chantierId], references: [id])
  tranche      String?
  remark       String?
  createdAt    DateTime @default(now())
}

model GpsPosition {
  id         String   @id @default(cuid())
  enginId    String
  engin      Engin    @relation(fields: [enginId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())
  source     String?
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Paramètres société / promoteur (singleton id = "default")
model CompanySettings {
  id               String   @id @default("default")
  companyName      String   @default("GIC — Expertise & Consulting")
  address          String?
  city             String?
  phone            String?
  email            String?
  ice              String?
  rc               String?
  logoPath         String?
  printDocSubtitle String?
  printFooterText  String?
  printLegalMentions String?
  printPrimaryColor String  @default("#007aff")
  printShowLogo    Boolean  @default(true)
  receiptTitle     String   @default("Reçu de paiement")
  /// Titre du document liste banque
  bankLetterTitle  String   @default("Demande de virement de salaires")
  /// Paragraphe d'accompagnement pour la banque
  bankLetterIntro  String   @default("Madame, Monsieur,\n\nNous vous prions de bien vouloir procéder au virement des salaires au profit des bénéficiaires dont la liste figure ci-après, selon les coordonnées bancaires (CIN et RIB) indiquées pour chacun.\n\nNous vous remercions de l'attention que vous porterez à la présente demande.\n\nCordialement,")
  bankLetterFooter String?
  updatedAt        DateTime @updatedAt
}

model SupplierDocument {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  purchaseId String?
  docType    String
  reference  String?
  filePath   String?
  data       String?
  createdAt  DateTime @default(now())
}
